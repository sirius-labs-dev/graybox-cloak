# GrayBox × Cloak API Gateway — environment variables
# Copy to .env and fill in your values before running `npm run dev`

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Storage ───────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the in-memory store (demo mode).
# In-memory mode pre-loads the demo institution with key g-p_demo_h6kj9d8s7g6f5d4.
DATABASE_URL=

# Required only when DATABASE_URL is set:
GPAY_MIGRATIONS_FILE=deploy/migrations/001_init.sql

# ── Security ──────────────────────────────────────────────────────────────────
# Secret for the internal /v1/internal/* endpoints (indexer → gateway).
# Rotate before deploying to production.
GPAY_INTERNAL_SECRET=dev-internal-secret-rotate

# ── Solana / Cloak ────────────────────────────────────────────────────────────
# RPC endpoint used by the MORA × Cloak relay.
# Cloak runs on mainnet; set accordingly.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Relay keypair as a JSON byte array — must hold SOL on the target network.
# Generate: solana-keygen new --outfile relay-keypair.json
# Then:     cat relay-keypair.json
# Leave empty to run in demo mode (no live on-chain relay calls).
RELAY_KEYPAIR_JSON=

# ── Demo router (/v1/demo/*) ──────────────────────────────────────────────────
# These are only needed when using the interactive demo endpoints.
# The demo router shells out to gpay-cli (from github.com/nzengi/g-pay).
# Build: cd /path/to/g-pay && cargo build --release --bin gpay-cli
#        then copy target/release/gpay-cli to GPAY_CLI path.

# Path to the gpay-cli binary (from github.com/nzengi/g-pay).
GPAY_CLI=/usr/local/bin/gpay-cli

# RPC for demo on-chain calls (devnet).
GPAY_RPC_URL=https://api.devnet.solana.com

# GrayBox quarantine vault authority pubkey (devnet).
GPAY_VAULT_AUTHORITY=

# Demo wallet keypair path — used as depositor and fee-payer in demo flows.
# Must be funded on devnet: solana airdrop 2 <pubkey> --url devnet
GPAY_DEMO_WALLET=/config/demo-wallet.json

# AML oracle keypair paths — two oracles required for attest endpoint.
GPAY_ORACLE_1=/config/oracles/o1.json
GPAY_ORACLE_2=/config/oracles/o2.json
